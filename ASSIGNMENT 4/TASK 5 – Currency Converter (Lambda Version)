import java.util.Scanner;

public class Main {

static double rate(String currency) {
    if (currency.equals("USD")) {
        return 0.012;
    } else {
        return 0.011;
    }
}

static void convert(double amount, String currency) {

    if (amount <= 0) {
        System.out.println("Invalid amount");
        return;
    }

    double convertedAmount = amount * rate(currency);

    System.out.printf(
        "Converted Amount: %.2f %s%n",
        convertedAmount, currency
    );
}

public static void main(String[] args) {

    Scanner sc = new Scanner(System.in);

    System.out.println("===== CURRENCY CONVERTER =====");

    System.out.print("Enter INR Amount: ");
    String input = sc.nextLine();

    System.out.println("\nSelect Target Currency:");
    System.out.println("1. USD");
    System.out.println("2. EUR");

    System.out.print("Enter your choice: ");
    String choice = sc.nextLine();

    String currency;

    if (choice.equals("1")) {
        currency = "USD";
    } else if (choice.equals("2")) {
        currency = "EUR";
    } else {
        System.out.println("Invalid Currency Selection");
        sc.close();
        return;
    }

    try {

        double amount = Double.parseDouble(input);

        convert(amount, currency);

    } catch (NumberFormatException e) {

        System.out.println("Invalid amount");
    }

    sc.close();
}
}
