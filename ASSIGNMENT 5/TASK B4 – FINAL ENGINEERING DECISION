import java.util.; import java.io.;

public class Main {

static class BusPass {
    String passId, regNo, name;
    int routeNo;
    double amount;

    BusPass(String passId, String regNo, String name,
            int routeNo, double amount) {
        this.passId = passId;
        this.regNo = regNo;
        this.name = name;
        this.routeNo = routeNo;
        this.amount = amount;
    }

    public String toString() {
        return passId + " | " + regNo + " | " + name
                + " | " + routeNo + " | " + amount;
    }
}

public static void main(String[] args) {

    ArrayList<BusPass> database = new ArrayList<>();
    ArrayList<String> errors = new ArrayList<>();

    String[] records = {
        "P1001,192311001,Arun,12,4500",
        "P1002,192311002,Divya,7,3800",
        "P1003,192311003,Kumar,ABC,5000",
        "P1004,192311004,Meena,15,4200",
        "P1005,192311005,Ravi,10,INVALID",
        "P1006,192311006,Anu,8,3900"
    };

    System.out.println("BUS PASS MIGRATION SYSTEM");
    System.out.println("-------------------------");

    for (int i = 0; i < records.length; i++) {

        try {
            String[] data = records[i].split(",", -1);

            if (data.length != 5) {
                throw new Exception("Incorrect number of fields");
            }

            String id = data[0].trim();
            String reg = data[1].trim();
            String name = data[2].trim();

            if (id.isEmpty() || reg.isEmpty() || name.isEmpty()) {
                throw new Exception("Empty field found");
            }

            int route = Integer.parseInt(data[3].trim());
            double amount = Double.parseDouble(data[4].trim());

            if (route <= 0 || amount < 0 ||
                    Double.isInfinite(amount) ||
                    Double.isNaN(amount)) {
                throw new Exception("Invalid route or amount");
            }

            database.add(new BusPass(
                    id, reg, name, route, amount));

        } catch (Exception e) {
            errors.add("Line " + (i + 1) + ": " + e.getMessage());
        }
    }

    System.out.println("\nMigration Completed");
    System.out.println("Valid Records: " + database.size());
    System.out.println("Failed Records: " + errors.size());

    System.out.println("\nVALID RECORDS");
    System.out.println("--------------");

    for (BusPass pass : database) {
        System.out.println(pass);
    }

    System.out.println("\nVALIDATION ERRORS");
    System.out.println("-----------------");

    for (String error : errors) {
        System.out.println(error);
    }

    System.out.println("\nDATABASE METADATA (SIMULATED)");
    System.out.println("-----------------------------");
    System.out.println("Storage Type: Java ArrayList");
    System.out.println("Table Name: bus_pass");
    System.out.println("Records Stored: " + database.size());

    System.out.println("\nFINAL RESULT");
    System.out.println("------------");
    System.out.println("Migration process completed successfully.");
}
}
