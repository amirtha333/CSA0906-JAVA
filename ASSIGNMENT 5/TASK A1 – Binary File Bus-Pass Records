import java.io.; import java.util.;

public class Main {

static final String FILE_NAME = "buspasses.dat";
static Scanner sc = new Scanner(System.in);

static void addPass() {

    try {
        System.out.print("Enter Pass ID: ");
        String id = sc.nextLine();

        System.out.print("Enter Register Number: ");
        String reg = sc.nextLine();

        System.out.print("Enter Student Name: ");
        String name = sc.nextLine();

        System.out.print("Enter Route Number: ");
        int route = Integer.parseInt(sc.nextLine());

        System.out.print("Enter Boarding Stop: ");
        String stop = sc.nextLine();

        System.out.print("Enter Validity Date (YYYY-MM-DD): ");
        String date = sc.nextLine();

        System.out.print("Enter Amount Paid: ");
        double amount = Double.parseDouble(sc.nextLine());

        if (id.isEmpty() || reg.isEmpty() || name.isEmpty()
                || stop.isEmpty() || amount < 0) {
            System.out.println("Invalid details.");
            return;
        }

        try (DataOutputStream dos = new DataOutputStream(
                new BufferedOutputStream(
                new FileOutputStream(FILE_NAME, true)))) {

            dos.writeUTF(id);
            dos.writeUTF(reg);
            dos.writeUTF(name);
            dos.writeInt(route);
            dos.writeUTF(stop);
            dos.writeUTF(date);
            dos.writeDouble(amount);
        }

        System.out.println("Pass added successfully.");

    } catch (Exception e) {
        System.out.println("Error: " + e.getMessage());
    }
}

static void searchPass() {

    System.out.print("Enter Pass ID to search: ");
    String searchId = sc.nextLine();

    boolean found = false;

    try (DataInputStream dis = new DataInputStream(
            new BufferedInputStream(
            new FileInputStream(FILE_NAME)))) {

        while (true) {

            String id = dis.readUTF();
            String reg = dis.readUTF();
            String name = dis.readUTF();
            int route = dis.readInt();
            String stop = dis.readUTF();
            String date = dis.readUTF();
            double amount = dis.readDouble();

            if (id.equalsIgnoreCase(searchId)) {

                System.out.println("\nPass Found!");
                System.out.println("Pass ID: " + id);
                System.out.println("Register Number: " + reg);
                System.out.println("Student Name: " + name);
                System.out.println("Route Number: " + route);
                System.out.println("Boarding Stop: " + stop);
                System.out.println("Validity Date: " + date);
                System.out.println("Amount Paid: " + amount);

                found = true;
                break;
            }
        }

    } catch (EOFException e) {
        // End of file reached
    } catch (FileNotFoundException e) {
        System.out.println("File not found.");
        return;
    } catch (IOException e) {
        System.out.println("File reading error.");
        return;
    }

    if (!found) {
        System.out.println("Pass not found.");
    }
}

static void listByRoute() {

    System.out.print("Enter Route Number: ");

    int searchRoute;

    try {
        searchRoute = Integer.parseInt(sc.nextLine());
    } catch (NumberFormatException e) {
        System.out.println("Invalid route number.");
        return;
    }

    boolean found = false;

    try (DataInputStream dis = new DataInputStream(
            new BufferedInputStream(
            new FileInputStream(FILE_NAME)))) {

        System.out.println("\nPasses on Route " + searchRoute + ":");

        while (true) {

            String id = dis.readUTF();
            String reg = dis.readUTF();
            String name = dis.readUTF();
            int route = dis.readInt();
            String stop = dis.readUTF();
            String date = dis.readUTF();
            double amount = dis.readDouble();

            if (route == searchRoute) {

                System.out.println("\nPass ID: " + id);
                System.out.println("Register Number: " + reg);
                System.out.println("Student Name: " + name);
                System.out.println("Route Number: " + route);
                System.out.println("Boarding Stop: " + stop);
                System.out.println("Validity Date: " + date);
                System.out.println("Amount Paid: " + amount);

                found = true;
            }
        }

    } catch (EOFException e) {
        // End of file reached
    } catch (FileNotFoundException e) {
        System.out.println("File not found.");
        return;
    } catch (IOException e) {
        System.out.println("File reading error.");
        return;
    }

    if (!found) {
        System.out.println("No passes found for this route.");
    }
}

public static void main(String[] args) {

    int choice = 0;

    do {

        System.out.println("\n===== BUS PASS RECORD SYSTEM =====");
        System.out.println("1. Add New Pass");
        System.out.println("2. Search Pass by ID");
        System.out.println("3. List Passes by Route");
        System.out.println("4. Exit");

        System.out.print("Enter your choice: ");

        try {
            choice = Integer.parseInt(sc.nextLine());
        } catch (NumberFormatException e) {
            System.out.println("Invalid choice.");
            choice = 0;
            continue;
        }

        switch (choice) {

            case 1:
                addPass();
                break;

            case 2:
                searchPass();
                break;

            case 3:
                listByRoute();
                break;

            case 4:
                System.out.println("Application closed.");
                break;

            default:
                System.out.println("Invalid choice.");
        }

    } while (choice != 4);

    sc.close();
}
}
