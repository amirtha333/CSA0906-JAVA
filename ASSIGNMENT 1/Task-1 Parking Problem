import java.util.Scanner;

class Vehicle { String regNo, type, entryTime;

Vehicle(String regNo, String type, String entryTime) {
    this.regNo = regNo;
    this.type = type;
    this.entryTime = entryTime;
}

void display() {
    System.out.println("Registration Number: " + regNo);
    System.out.println("Vehicle Type: " + type);
    System.out.println("Entry Time: " + entryTime);
}
}

class ParkingSlot { int slotNo; Vehicle vehicle;

ParkingSlot(int slotNo) {
    this.slotNo = slotNo;
}
}

class ParkingTicket { static int count = 1001;

int ticketNo;

ParkingTicket() {
    ticketNo = count++;
}
}

class ParkingLot { ParkingSlot[] slots;

ParkingLot(int n) {
    slots = new ParkingSlot[n];

    for (int i = 0; i < n; i++) {
        slots[i] = new ParkingSlot(i + 1);
    }
}

void parkVehicle(Vehicle v) {

    if (findVehicle(v.regNo) != null) {
        System.out.println("Vehicle Already Parked!");
        return;
    }

    for (int i = 0; i < slots.length; i++) {
        if (slots[i].vehicle == null) {
            slots[i].vehicle = v;

            ParkingTicket t = new ParkingTicket();

            System.out.println("Vehicle Parked Successfully!");
            System.out.println("Slot Number: " + slots[i].slotNo);
            System.out.println("Ticket Number: " + t.ticketNo);
            return;
        }
    }

    System.out.println("Parking is Full!");
}

Vehicle findVehicle(String regNo) {
    for (int i = 0; i < slots.length; i++) {
        if (slots[i].vehicle != null &&
            slots[i].vehicle.regNo.equalsIgnoreCase(regNo)) {
            return slots[i].vehicle;
        }
    }
    return null;
}

void removeVehicle(String regNo) {
    for (int i = 0; i < slots.length; i++) {
        if (slots[i].vehicle != null &&
            slots[i].vehicle.regNo.equalsIgnoreCase(regNo)) {

            slots[i].vehicle = null;
            System.out.println("Vehicle Removed Successfully!");
            return;
        }
    }

    System.out.println("Vehicle Not Found!");
}

void displayVehicles() {
    for (int i = 0; i < slots.length; i++) {
        if (slots[i].vehicle != null) {
            System.out.println("\nSlot Number: " + slots[i].slotNo);
            slots[i].vehicle.display();
        }
    }
}
}

public class Main { public static void main(String[] args) {

    Scanner sc = new Scanner(System.in);

    System.out.print("Enter Total Parking Slots: ");
    int n = sc.nextInt();
    sc.nextLine();

    ParkingLot lot = new ParkingLot(n);

    int choice;

    do {
        System.out.println("\n1. Park Vehicle");
        System.out.println("2. Search Vehicle");
        System.out.println("3. Remove Vehicle");
        System.out.println("4. Display Vehicles");
        System.out.println("5. Exit");

        System.out.print("Enter Your Choice: ");
        choice = sc.nextInt();
        sc.nextLine();

        switch (choice) {

            case 1:
                System.out.print("Enter Registration Number: ");
                String reg = sc.nextLine();

                System.out.print("Enter Vehicle Type: ");
                String type = sc.nextLine();

                System.out.print("Enter Entry Time: ");
                String time = sc.nextLine();

                Vehicle v = new Vehicle(reg, type, time);
                lot.parkVehicle(v);
                break;

            case 2:
                System.out.print("Enter Registration Number: ");
                String search = sc.nextLine();

                Vehicle result = lot.findVehicle(search);

                if (result != null) {
                    System.out.println("Vehicle Found!");
                    result.display();
                } else {
                    System.out.println("Vehicle Not Found!");
                }
                break;

            case 3:
                System.out.print("Enter Registration Number: ");
                String remove = sc.nextLine();
                lot.removeVehicle(remove);
                break;

            case 4:
                lot.displayVehicles();
                break;

            case 5:
                System.out.println("Thank You!");
                break;

            default:
                System.out.println("Invalid Choice!");
        }

    } while (choice != 5);

    sc.close();
}
}
