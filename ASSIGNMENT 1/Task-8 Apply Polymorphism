interface Chargeable { double chargingFee(int kWh); }

abstract class Vehicle { private final String regNo;

protected Vehicle(String regNo) {
    this.regNo = regNo;
}

public String getRegNo() {
    return regNo;
}

protected abstract double ratePerHour();

public double calculateFee(int minutes) {
    int hours = (minutes + 59) / 60;
    return hours * ratePerHour();
}

// Method overloading
public double calculateFee(int hours, int minutes) {
    int totalMinutes = hours * 60 + minutes;
    return calculateFee(totalMinutes);
}

@Override
public boolean equals(Object o) {
    if (o instanceof Vehicle) {
        Vehicle v = (Vehicle) o;
        return regNo.equals(v.regNo);
    }
    return false;
}

@Override
public int hashCode() {
    return regNo.hashCode();
}
}

class TwoWheeler extends Vehicle { TwoWheeler(String regNo) { super(regNo); }

@Override
protected double ratePerHour() {
    return 10;
}
}

class Car extends Vehicle { Car(String regNo) { super(regNo); }

@Override
protected double ratePerHour() {
    return 30;
}
}

class ElectricCar extends Car implements Chargeable { ElectricCar(String regNo) { super(regNo); }

@Override
public double chargingFee(int kWh) {
    return kWh * 12;
}
}

public class Main { public static void main(String[] args) {

    Vehicle[] parked = {
        new TwoWheeler("TN01A1"),
        new Car("TN02B2"),
        new ElectricCar("TN03C3")
    };

    for (Vehicle v : parked) {
        double fee = v.calculateFee(130);

        if (v instanceof Chargeable) {
            fee += ((Chargeable) v).chargingFee(10);
        }

        System.out.println(
            v.getClass().getSimpleName()
            + " " + v.getRegNo()
            + " -> Rs " + fee
        );
    }

    System.out.println(
        new Car("TN02B2").equals(
            new ElectricCar("TN02B2")
        )
    );
}
}
